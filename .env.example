# Cosmos Explorer — Environment Variable Template (Doc 28 §6, viz.md §1)
# Copy to `.env` at repo root (backend) and `apps/web/.env.local` (frontend).
# Neither file is committed — see .gitignore.
#
# Consumer legend: [pg] postgres  [api] apps/api  [tile] apps/tile-server
#                  [eph] apps/ephemeris  [etl] apps/etl  [web] apps/web

# ----------------------------------------------------------------------------
# Backend (.env — repo root)
# ----------------------------------------------------------------------------

# [pg] Postgres superuser password. Used by docker-compose for container init
# and by [api][tile][etl] inside DATABASE_URL. Change for production.
POSTGRES_PASSWORD=cosmos_dev_changeme

# [api][tile][etl] Postgres connection string. Kept in sync with POSTGRES_PASSWORD.
DATABASE_URL=postgresql://cosmos:cosmos_dev_changeme@localhost:5432/cosmos

# [api][tile] Redis URL for rate limiting + tile cache.
REDIS_URL=redis://localhost:6379

# [api][etl] Elasticsearch base URL for autocomplete + full-text search.
ELASTICSEARCH_URL=http://localhost:9200

# [etl] NASA Exoplanet Archive / NASA ADS API key. Use DEMO_KEY for low-volume
# dev. Request a personal key at https://api.nasa.gov/ before full ingest.
NASA_API_KEY=DEMO_KEY

# [etl] Host-side path where Gaia DR3 raw CSVs are staged during ingest.
# Relative to repo root; override to absolute path on a large data disk.
GAIA_DATA_DIR=./data/raw/gaia

# [eph] Host-side path where SPICE kernels (DE441 etc.) live. Git LFS tracked.
SPICE_KERNEL_DIR=./data/spice

# [api][tile][eph] Service ports. Docker-compose maps host → container 1:1.
API_PORT=3000
TILE_SERVER_PORT=3001
EPHEMERIS_PORT=3002

# [api][tile][eph][etl] Log verbosity. trace|debug|info|warn|error.
LOG_LEVEL=debug

# [api] Allow-list for browser origins. Comma-separated if multiple.
CORS_ORIGIN=http://localhost:5173

# [api] Rate limits per IP per minute by auth tier (Doc 26 §13).
RATE_LIMIT_ANONYMOUS=60
RATE_LIMIT_REGISTERED=300

# ----------------------------------------------------------------------------
# Frontend (apps/web/.env.local)
# ----------------------------------------------------------------------------

# [web] Backend base URLs. Client falls back to bundled seed catalog on 5xx.
VITE_API_BASE_URL=http://localhost:3000/v1
VITE_WS_URL=ws://localhost:3000/v1/ws
VITE_TILE_SERVER_URL=http://localhost:3001/v1
VITE_EPHEMERIS_URL=http://localhost:3002/v1

# [web] Feature flags.
VITE_ENABLE_MOCK_API=false
VITE_ENABLE_DEVTOOLS=true

# [web] Observability sinks (optional).
VITE_SENTRY_DSN=
VITE_ANALYTICS_ENDPOINT=
