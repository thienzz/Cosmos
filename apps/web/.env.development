# T18 — dev build talks to the API gateway via the Vite proxy (/v1 → 8080).
# The API base URL is *relative* in dev so same-origin CORS rules apply.
VITE_API_BASE_URL=/v1

# T-E-08 — binary tile reads go directly to the Rust tile server. Must
# include the `/v1` path prefix so `/tiles/...` lines up with the Rust
# router's `/v1/tiles/...` routes. Leave unset to fall through to the
# API gateway's `/tiles/...` proxy (production unified-origin mode).
VITE_TILE_SERVER_URL=http://localhost:3001/v1
