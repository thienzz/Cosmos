{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "outDir": "dist",
    "rootDir": ".",
    "noEmit": false
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts", "tests/**/*.tsx"],
  "references": [
    { "path": "../../packages/shared-types" },
    { "path": "../../packages/coordinate-utils" },
    { "path": "../../packages/tile-decoder" },
    { "path": "../../packages/api-client" }
  ]
}
