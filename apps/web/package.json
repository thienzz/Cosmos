{
  "name": "@cosmos/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_ENABLE_MOCK_API=true vite",
    "dev:https": "vite --https",
    "build": "tsc -b && vite build",
    "build:analyze": "vite build --mode analyze",
    "preview": "vite preview",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:visual": "vitest run --passWithNoTests tests/visual",
    "test:visual:capture": "tsx tests/visual/capture.ts",
    "test:visual:capture-all": "tsx tests/visual/capture.ts --all",
    "seed:export": "vite-node scripts/export-ts-catalog.ts"
  },
  "dependencies": {
    "@cosmos/api-client": "workspace:*",
    "@cosmos/coordinate-utils": "workspace:*",
    "@cosmos/shared-types": "workspace:*",
    "@cosmos/tile-decoder": "workspace:*",
    "dexie": "^4.0.0",
    "jotai": "^2.4.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "three": "0.184.0",
    "tone": "^14.8.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@rollup/pluginutils": "^5.1.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "0.184.0",
    "@vitejs/plugin-react": "^4.2.0",
    "jsdom": "^24.0.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vite": "^5.1.0",
    "vite-node": "^6.0.0",
    "vite-plugin-glsl": "^1.3.0",
    "vitest": "^1.0.0"
  }
}
