{
  "name": "@cosmos/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "migrate:up": "node dist/migrate.js up",
    "es:bootstrap": "tsx scripts/bootstrap-es.ts"
  },
  "dependencies": {
    "@cosmos/shared-types": "workspace:*",
    "@elastic/elasticsearch": "^9.3.4",
    "@fastify/cors": "^9.0.0",
    "@fastify/etag": "^5.0.0",
    "@fastify/rate-limit": "^9.0.0",
    "envalid": "^8.0.0",
    "fastify": "^4.26.0",
    "fastify-plugin": "^5.1.0",
    "ioredis": "^5.3.0",
    "pg": "^8.11.0",
    "pino": "^8.17.0",
    "pino-pretty": "^13.1.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.0.0"
  }
}
